<% pageTitle = 'Join as a Journalist' %>
<%- include('partials/header') %>

<div class="login-wrap">
  <div class="login-card">
    <h1>Join Campus Pulse</h1>
    <p class="sub">Register as a journalist. An editor will need to approve your account before you can log in.</p>

    <% if (error) { %>
      <div class="error-msg"><%= error %></div>
    <% } %>
    <% if (success) { %>
      <div class="feedback-note"><%= success %></div>
    <% } %>

    <% if (!success) { %>
      <form action="/register" method="POST">
        <div class="form-group">
          <label for="name">Full name</label>
          <input type="text" id="name" name="name" required>
        </div>
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" required>
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <div class="pw-field-wrap">
            <input type="password" id="password" name="password" required minlength="6">
            <button type="button" class="pw-toggle" data-target="password">Show</button>
          </div>
        </div>
        <div class="form-group">
          <label for="confirm_password">Confirm password</label>
          <div class="pw-field-wrap">
            <input type="password" id="confirm_password" name="confirm_password" required minlength="6">
            <button type="button" class="pw-toggle" data-target="confirm_password">Show</button>
          </div>
        </div>
        <button type="submit" class="btn btn-primary" style="width:100%">Request Account</button>
      </form>
    <% } %>

    <div class="divider">or</div>
    <a href="/login" class="btn btn-ghost" style="width:100%; text-align:center; display:block;">Back to Login</a>
  </div>
</div>

<%- include('partials/footer') %>
