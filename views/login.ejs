<% pageTitle = 'Login' %>
<%- include('partials/header') %>

<div class="login-wrap">
  <div class="login-card">
    <h1>Team Login</h1>
    <p class="sub">Sign in with your Campus Pulse account.</p>

    <% if (error) { %>
      <div class="error-msg"><%= error %></div>
    <% } %>

    <form action="/login" method="POST">
      <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required>
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <div class="pw-field-wrap">
          <input type="password" id="password" name="password" required>
          <button type="button" class="pw-toggle" data-target="password">Show</button>
        </div>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%">Log In</button>
    </form>

    <p style="text-align:center; font-size:0.85rem; margin-top:14px;">
      New journalist? <a href="/register" style="color:var(--color-primary); font-weight:600;">Request an account</a>
    </p>

    <div class="divider">Lecturer demo access</div>

    <div class="demo-buttons">
      <form action="/login/demo/journalist" method="POST">
        <button type="submit" class="btn btn-navy">Log in as Demo Journalist</button>
      </form>
      <form action="/login/demo/editor" method="POST">
        <button type="submit" class="btn btn-primary">Log in as Demo Editor</button>
      </form>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
